server:
  port: 8099

spring:
  datasource:
    # rewriteBatchedStatements=true：让 MySQL 驱动把同一批次的多条 INSERT 合并为一条网络往返（批量判分落库的关键）
    url: jdbc:mysql://<DB_HOST>:3306/<DB_NAME>?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8&rewriteBatchedStatements=true
    username: <DB_USERNAME>
    password: <DB_PASSWORD>
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      pool-name: exam-hikari
      maximum-pool-size: 20
      # 远程库会按自身 wait_timeout 关闭空闲连接，池内死连接会让请求在"验证-淘汰-重建"上多耗数秒；
      # 调低 minimum-idle 与 max-lifetime，减少持有被服务端关闭的连接的概率
      minimum-idle: 2
      idle-timeout: 600000
      max-lifetime: 600000
      connection-timeout: 10000
      validation-timeout: 3000
  jpa:
    hibernate:
      ddl-auto: none
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
        jdbc:
          batch_size: 50
          order_inserts: true
          order_updates: true
          batch_versioned_data: true
    open-in-view: false
  sql:
    init:
      mode: always
      platform: mysql
      continue-on-error: true

  jackson:
    time-zone: Asia/Shanghai
    serialization:
      WRITE_DATES_AS_TIMESTAMPS: false

jwt:
  secret: "change-this-secret-to-a-long-random-string"
  issuer: "exam-site"
  expiry-minutes: 120

logging:
  level:
    org.hibernate.SQL: warn
    org.springframework.security: info